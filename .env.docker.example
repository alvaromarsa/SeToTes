# Variables secretas para docker-compose.yml (SOLO desarrollo local).
# Copia este archivo como .env.docker (no se versiona) y cambia los valores.
# Las variables no secretas (NODE_ENV, CORS_ORIGIN, URLs…) están en docker-compose.yml.

# Contraseña del PostgreSQL del compose. Debe coincidir con la de DATABASE_URL.
POSTGRES_PASSWORD=contraseña1

# Conexión del backend a la base de datos del compose: el servidor es "db" (nombre del servicio)
# y el puerto el interno, 5432 (el 5433 es solo para conectarse desde fuera del contenedor)
DATABASE_URL=postgres://totebag:contraseña1@db:5432/totebag_db

# Secreto para firmar los JWT. Genera uno largo y aleatorio:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=7f0ff6bcdfd58c98b718332c117097e57ac7d009f2b1acb871a193cd6bcc63210ffdcce9bdd815d655edc4e14503f7c8a12f7991b8e7783c9568b83f5a39635f

# Stripe en modo pruebas (la clave debe empezar por sk_test_).
# El webhook secret lo muestra "stripe listen --forward-to localhost:3000/api/payments/webhook"
STRIPE_SECRET_KEY=sk_test_51UYTJaFHsTklbCnLcaeRALpQrOmWQ4Uzcdd9CNIAbrMaaSs2LYxUAm4fuB9VKu2g8uBjvgVyeSEPkDHl7cyvBszF00s4HagAv6
STRIPE_WEBHOOK_SECRET=whsec_c5b69b0ac31d8b17d01a157043c3670b444000f819509c8198aa53c26ba0e1dc
