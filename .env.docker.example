# Variables secretas para docker-compose.yml (SOLO desarrollo local).
# Copia este archivo como .env.docker (no se versiona) y cambia los valores.
# Las variables no secretas (NODE_ENV, CORS_ORIGIN, URLs…) están en docker-compose.yml.

# Contraseña del PostgreSQL del compose. Debe coincidir con la de DATABASE_URL.
POSTGRES_PASSWORD=change_me

# Conexión del backend a la base de datos del compose: el servidor es "db" (nombre del servicio)
# y el puerto el interno, 5432 (el 5433 es solo para conectarse desde fuera del contenedor)
DATABASE_URL=postgres://totebag:contraseña1@db:5432/totebag_db

# Secreto para firmar los JWT. Genera uno largo y aleatorio:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me
# Stripe en modo pruebas (la clave debe empezar por sk_test_).
# El webhook secret lo muestra "stripe listen --events checkout.session.completed,checkout.session.expired --forward-to localhost:3000/api/payments/webhook"
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Almacenamiento de imágenes: local (disco, volumen uploads) o s3 (MinIO del compose).
# Con s3, levantar con: docker compose --profile s3 up -d --build
STORAGE_DRIVER=local

# MinIO (solo con el perfil s3). Administrador: lo usan minio y minio-init, nunca la API.
# La contraseña debe tener al menos 8 caracteres.
MINIO_ROOT_USER=admin_de_ejemplo
MINIO_ROOT_PASSWORD=cambia_esta_contrasena_admin

# Usuario de la API en MinIO (lo crea minio-init con permisos mínimos: subir, leer y borrar
# en products/*). La clave secreta debe tener al menos 8 caracteres.
S3_ACCESS_KEY_ID=api_de_ejemplo
S3_SECRET_ACCESS_KEY=cambia_esta_clave_de_la_api
