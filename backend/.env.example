# Copia este archivo como backend/.env y rellena los valores reales.

# Servidor
PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas. Nunca "*".
# En desarrollo, si no se define, se usa http://localhost:4200. En producción es obligatorio.
CORS_ORIGIN=http://localhost:4200

# URL pública del backend, usada para construir las URLs de las imágenes (sin / final).
# En desarrollo, si no se define, se usa http://localhost:3000. En producción es obligatoria.
PUBLIC_BASE_URL=http://localhost:3000

# URL del frontend, para los enlaces de los emails (sin / final).
# En desarrollo, si no se define, se usa http://localhost:4200. En producción es obligatoria.
FRONTEND_URL=http://localhost:4200

# Email. "console": imprime los emails en la terminal (por defecto fuera de producción).
# "smtp": los envía de verdad; obligatorio en producción y exige todas las variables de abajo.
EMAIL_MODE=console
# SMTP_PORT 465 usa TLS directo; 587 usa STARTTLS.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=cambia_esta_contrasena
EMAIL_FROM="SeToTes <no-reply@ejemplo.com>"

# Base de datos PostgreSQL: o DATABASE_URL (bases de datos gestionadas), o las cinco DB_*.
# Si DATABASE_URL está definida, tiene prioridad. En producción el servidor no arranca sin una de las dos.
# Ojo: un "sslmode=..." dentro de DATABASE_URL tiene prioridad sobre DB_SSL.
# DATABASE_URL=postgres://usuario:contrasena@servidor:5432/totebag_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=totebag_db
DB_USER=totebag_user
DB_PASSWORD=cambia_esta_contrasena

# SSL con la base de datos: true por defecto en producción y false en desarrollo.
# Siempre verifica el certificado del servidor. Con una base de datos local sin SSL en
# producción (p. ej. en el mismo servidor), pon DB_SSL=false.
# DB_SSL=true
# Solo si el proveedor usa su propia autoridad de certificación: el certificado en PEM
# (en una línea, con \n en los saltos). Nunca se desactiva la verificación.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Pool de conexiones (valores por defecto entre paréntesis)
# DB_POOL_MAX=10                  (conexiones simultáneas como máximo)
# DB_IDLE_TIMEOUT_MS=30000        (cierra una conexión inactiva tras este tiempo)
# DB_CONNECTION_TIMEOUT_MS=5000   (error si no consigue conexión en este tiempo)

# Secreto para firmar los JWT (obligatorio; en producción, 32 caracteres como mínimo).
# Genera uno largo y aleatorio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_este_secreto

# Stripe (obligatorias). Fuera de producción la clave secreta debe ser de prueba (sk_test_...).
# Clave: panel de Stripe > Desarrolladores > Claves de API (modo de prueba).
# Webhook en local: la muestra "stripe listen --forward-to localhost:3000/api/payments/webhook".
# En producción: la del endpoint registrado en el panel de Stripe.
STRIPE_SECRET_KEY=sk_test_clave_de_ejemplo_no_valida
STRIPE_WEBHOOK_SECRET=whsec_secreto_de_ejemplo_no_valido

# Número de proxies delante del backend (balanceador de la plataforma de despliegue).
# 0 = ninguno (local). Con el valor correcto, el límite de intentos usa la IP real del cliente.
# Un valor MAYOR que los proxies reales permite falsear la IP con X-Forwarded-For.
TRUST_PROXY=0

# Cierre ordenado: tiempo máximo (ms) para terminar las peticiones en curso al apagar el servidor
# SHUTDOWN_TIMEOUT_MS=10000

# Reconciliación con Stripe (cubre webhooks perdidos). Enteros >= 1.
# Edad mínima del pedido para revisarlo y minutos entre pasadas. Para probar en local: 1 y 1.
# RECONCILE_MIN_AGE_MINUTES=10
# RECONCILE_INTERVAL_MINUTES=5

# Almacenamiento de imágenes. local (por defecto): disco, servido por el backend en /uploads.
# s3: cualquier almacenamiento compatible con S3 (R2, S3, Backblaze B2, MinIO); exige TODAS las
# variables de abajo. En producción, S3_ENDPOINT y PUBLIC_IMAGES_BASE_URL deben ser https.
# Credenciales de mínimo privilegio: solo subir, leer y borrar en el bucket (nunca la clave maestra).
# STORAGE_DRIVER=local
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=totebag-images
# S3_ACCESS_KEY_ID=clave_de_ejemplo
# S3_SECRET_ACCESS_KEY=secreto_de_ejemplo
# S3_FORCE_PATH_STYLE=true
# URL pública desde la que el navegador descarga las imágenes (sin / final); se le añade products/<archivo>
# PUBLIC_IMAGES_BASE_URL=https://imagenes.setotes.es
