# Copia este archivo como backend/.env y rellena los valores reales.

# Servidor
PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas. Nunca "*".
# En desarrollo, si no se define, se usa http://localhost:4200. En producción es obligatorio.
CORS_ORIGIN=http://localhost:4200

# URL pública del backend, usada para construir las URLs de las imágenes (sin / final).
# En desarrollo, si no se define, se usa http://localhost:3000. En producción es obligatoria.
PUBLIC_BASE_URL=http://localhost:3000

# URL del frontend, para los enlaces de los emails (sin / final).
# En desarrollo, si no se define, se usa http://localhost:4200. En producción es obligatoria.
FRONTEND_URL=http://localhost:4200

# Email. "console": imprime los emails en la terminal (por defecto fuera de producción).
# "smtp": los envía de verdad; obligatorio en producción y exige todas las variables de abajo.
EMAIL_MODE=console
# SMTP_PORT 465 usa TLS directo; 587 usa STARTTLS.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=cambia_esta_contrasena
EMAIL_FROM="SeToTes <no-reply@ejemplo.com>"

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=totebag_db
DB_USER=totebag_user
DB_PASSWORD=cambia_esta_contrasena

# Secreto para firmar los JWT (obligatorio). Genera uno largo y aleatorio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_este_secreto

# Stripe (obligatorias). Fuera de producción la clave secreta debe ser de prueba (sk_test_...).
# Clave: panel de Stripe > Desarrolladores > Claves de API (modo de prueba).
# Webhook en local: la muestra "stripe listen --forward-to localhost:3000/api/payments/webhook".
# En producción: la del endpoint registrado en el panel de Stripe.
STRIPE_SECRET_KEY=sk_test_clave_de_ejemplo_no_valida
STRIPE_WEBHOOK_SECRET=whsec_secreto_de_ejemplo_no_valido

# Número de proxies delante del backend (balanceador de la plataforma de despliegue).
# 0 = ninguno (local). Con el valor correcto, el límite de intentos usa la IP real del cliente.
# Un valor MAYOR que los proxies reales permite falsear la IP con X-Forwarded-For.
TRUST_PROXY=0
